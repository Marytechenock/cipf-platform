# Copy to deploy.env on the server and fill in the values below.
# deploy.env is ignored by Git. Use a distinct HTTPS hostname without a trailing slash.
CIPF_PUBLIC_APP_URL=
CIPF_BIND_ADDRESS=127.0.0.1
CIPF_HOST_PORT=3001
CIPF_COOKIE_SECURE=true
CIPF_DB_NAME=cip_election
CIPF_DB_USER=cipf_user
DB_PASSWORD=
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL=8h
AUTH_IDLE_TIMEOUT=15m

# Only trust the reverse proxy hop that overwrites X-Forwarded-For.
CIPF_TRUST_PROXY_HOPS=1
SUPER_ADMIN_BOOTSTRAP_EMAIL=
SUPER_ADMIN_BOOTSTRAP_PASSWORD=

# Required to email newly created admin accounts.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
