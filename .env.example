# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maz_winter_school
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_AUTO_CREATE=false

# App Auth
AUTH_TOKEN_SECRET=replace_with_a_long_random_secret
AUTH_TOKEN_TTL=7d
ADMIN_BOOTSTRAP_EMAIL=admin@maz.co.zw
ADMIN_BOOTSTRAP_PASSWORD=replace_with_a_temporary_admin_password
ADMIN_BOOTSTRAP_FORCE_RESET=false
ADMIN_BOOTSTRAP_FIRST_NAME=System
ADMIN_BOOTSTRAP_LAST_NAME=Administrator
SUPER_ADMIN_BOOTSTRAP_EMAIL=
SUPER_ADMIN_BOOTSTRAP_PASSWORD=
SUPER_ADMIN_BOOTSTRAP_FIRST_NAME=System
SUPER_ADMIN_BOOTSTRAP_LAST_NAME=Owner
COOKIE_SECURE=true
COOKIE_DOMAIN=
CORS_ALLOWED_ORIGINS=https://maztechplatform.co.zw

# Public URL used in outgoing emails
PUBLIC_APP_URL=https://maztechplatform.co.zw

# Outgoing email for attendee QR codes
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_smtp_username
SMTP_PASS=replace_with_smtp_password
MAIL_FROM="MAZ Business Institute <no-reply@maztechplatform.co.zw>"

# AI Provider
GROQ_API_KEY=replace_with_your_groq_api_key
